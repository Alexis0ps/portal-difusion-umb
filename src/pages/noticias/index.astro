---
import Layout from "../../layouts/Layout.astro";

const archivos = import.meta.glob("../../content/noticias/*.md", {
    eager: true,
});
const todasLasNoticias = Object.keys(archivos).map((ruta) => ({
    ...(archivos[ruta] as any),
    file: ruta,
}));

const noticiasRecientes = todasLasNoticias.sort(
    (a: any, b: any) =>
        new Date(b.frontmatter.date).valueOf() -
        new Date(a.frontmatter.date).valueOf(),
);

const noticiaDestacada = noticiasRecientes[0];
const restoNoticias = noticiasRecientes.slice(1);
---

<Layout>
    <div
        class="w-full bg-slate-50 text-gray-800 py-10 md:py-16 font-sans relative"
    >
        <div
            class="max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-6 relative z-10"
        >
            <div class="max-w-5xl mx-auto w-full">
                <div class="flex justify-between items-center mb-8">
                    <h1
                        class="text-4xl font-serif text-gray-900 font-extrabold tracking-wide"
                    >
                        Noticias
                    </h1>
                    <div class="flex gap-4">
                        <div
                            id="btn-guardar"
                            class="w-11 h-11 rounded-full bg-white shadow-sm border border-gray-200 flex items-center justify-center text-gray-600 cursor-pointer hover:text-umb-verde hover:bg-green-50 transition"
                        >
                            <svg
                                id="icono-guardar"
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                                ></path>
                            </svg>
                        </div>

                        <div
                            id="btn-notificaciones"
                            class="w-11 h-11 rounded-full bg-white shadow-sm border border-gray-200 flex items-center justify-center text-gray-600 cursor-pointer hover:text-umb-verde hover:bg-green-50 transition relative"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                                ></path>
                            </svg>
                            <span
                                class="absolute top-2 right-2 w-2.5 h-2.5 bg-umb-verde rounded-full border-2 border-white"
                            ></span>
                        </div>
                    </div>
                </div>

                <div
                    class="flex gap-3 mb-8 overflow-x-auto pb-4 scrollbar-hide"
                >
                    <button
                        id="filtro-destacado"
                        class="px-6 py-2.5 rounded-full bg-gray-900 text-white font-bold text-sm shadow-md transition-colors"
                    >
                        Destacado
                    </button>
                    <button
                        id="filtro-reciente"
                        class="px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 font-bold text-sm shadow-sm transition-colors"
                    >
                        Reciente
                    </button>
                </div>

                <div id="contenedor-destacada">
                    {
                        noticiaDestacada && (
                            <a
                                href={`/noticias/${noticiaDestacada.file.split("/").pop().replace(".md", "")}`}
                                class="block mb-12 group bg-white rounded-[2.5rem] p-4 shadow-xl shadow-gray-200/50 border border-gray-100 transition-all hover:-translate-y-1"
                            >
                                <div class="w-full h-64 md:h-[350px] rounded-[2rem] overflow-hidden mb-6">
                                    {noticiaDestacada.frontmatter.image ? (
                                        <img
                                            src={
                                                noticiaDestacada.frontmatter
                                                    .image
                                            }
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                                            <span class="text-5xl opacity-20">
                                                📰
                                            </span>
                                        </div>
                                    )}
                                </div>
                                <div class="px-2">
                                    <div class="flex gap-3 mb-4">
                                        <span class="px-4 py-1.5 rounded-full bg-green-50 border border-green-100 text-xs font-bold text-umb-verde">
                                            #1 Tendencia
                                        </span>
                                        <span class="px-4 py-1.5 rounded-full bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-500">
                                            Institucional
                                        </span>
                                    </div>
                                    <h2 class="text-3xl font-serif text-gray-900 mb-6 font-extrabold leading-snug group-hover:text-umb-verde transition-colors">
                                        {noticiaDestacada.frontmatter.title}
                                    </h2>
                                    <div class="flex items-center justify-between pb-2">
                                        <div class="flex items-center gap-3 text-sm text-gray-500">
                                            <div class="w-9 h-9 rounded-full bg-umb-verde text-white flex items-center justify-center font-bold text-xs shadow-md">
                                                U
                                            </div>
                                            <span class="font-bold text-gray-700">
                                                Difusión UMB
                                            </span>
                                            <span>•</span>
                                            <span class="font-medium text-gray-500">
                                                {new Date(
                                                    noticiaDestacada.frontmatter
                                                        .date,
                                                ).toLocaleDateString("es-MX", {
                                                    day: "numeric",
                                                    month: "short",
                                                })}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        )
                    }
                </div>

                <div id="contenedor-lista" class="flex flex-col gap-5">
                    {
                        restoNoticias.map((noticia: any) => (
                            <a
                                href={`/noticias/${noticia.file.split("/").pop().replace(".md", "")}`}
                                class="flex items-center gap-5 group bg-white p-3 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition-all hover:-translate-y-1"
                            >
                                <div class="w-28 h-28 md:w-32 md:h-32 shrink-0 rounded-[1.5rem] overflow-hidden relative">
                                    {noticia.frontmatter.image ? (
                                        <img
                                            src={noticia.frontmatter.image}
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                                            <span class="text-3xl opacity-20">
                                                📰
                                            </span>
                                        </div>
                                    )}
                                </div>
                                <div class="flex flex-col justify-center flex-grow pr-3">
                                    <h3 class="text-lg md:text-xl font-serif text-gray-900 font-bold mb-2 leading-snug group-hover:text-umb-verde transition-colors line-clamp-2">
                                        {noticia.frontmatter.title}
                                    </h3>
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="font-bold text-gray-700">
                                            UMB
                                        </span>
                                        <span class="text-gray-300">•</span>
                                        <span class="font-medium text-gray-500">
                                            {new Date(
                                                noticia.frontmatter.date,
                                            ).toLocaleDateString("es-MX", {
                                                day: "numeric",
                                                month: "short",
                                            })}
                                        </span>
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    // 1. Lógica del Botón Guardar
    const btnGuardar = document.getElementById("btn-guardar");
    const iconoGuardar = document.getElementById("icono-guardar");
    let estaGuardado = false;

    btnGuardar.addEventListener("click", () => {
        estaGuardado = !estaGuardado;
        if (estaGuardado) {
            iconoGuardar.setAttribute("fill", "currentColor"); // Rellena el ícono
            alert("¡Sección guardada en tus marcadores locales!");
        } else {
            iconoGuardar.setAttribute("fill", "none"); // Vacía el ícono
            alert("Sección eliminada de tus marcadores.");
        }
    });

    // 2. Lógica de la Campanita (Simulación de Push Notifications)
    const btnNotificaciones = document.getElementById("btn-notificaciones");

    btnNotificaciones.addEventListener("click", () => {
        const respuesta = confirm(
            "¿El portal 'umb.edu.mx' quiere enviarte notificaciones. ¿Deseas permitirlo?",
        );
        if (respuesta) {
            alert(
                "¡Notificaciones activadas! Te avisaremos cuando haya nuevas convocatorias.",
            );
        }
    });

    // 3. Lógica de los Filtros
    const btnDestacado = document.getElementById("filtro-destacado");
    const btnReciente = document.getElementById("filtro-reciente");
    const contenedorDestacada = document.getElementById("contenedor-destacada");

    // Estado inicial: botón Destacado está activo (negro)

    btnReciente.addEventListener("click", () => {
        // Cambiar colores
        btnReciente.className =
            "px-6 py-2.5 rounded-full bg-gray-900 text-white font-bold text-sm shadow-md transition-colors";
        btnDestacado.className =
            "px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 font-bold text-sm shadow-sm transition-colors";

        // Ocultar noticia principal gigante
        contenedorDestacada.style.display = "none";
    });

    btnDestacado.addEventListener("click", () => {
        // Cambiar colores
        btnDestacado.className =
            "px-6 py-2.5 rounded-full bg-gray-900 text-white font-bold text-sm shadow-md transition-colors";
        btnReciente.className =
            "px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 font-bold text-sm shadow-sm transition-colors";

        // Mostrar noticia principal gigante
        contenedorDestacada.style.display = "block";
    });
</script>

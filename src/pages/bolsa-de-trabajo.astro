---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section
        class="w-full bg-slate-50 py-12 md:py-20 font-sans relative overflow-hidden flex-grow"
    >
        <div
            class="absolute top-0 left-0 w-full h-[600px] bg-gradient-to-b from-green-50 to-slate-50 z-0 pointer-events-none"
        >
        </div>

        <div
            class="max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-6 relative z-10"
        >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5 flex flex-col justify-center">
                    <h1
                        class="text-5xl md:text-6xl font-serif text-gray-900 font-extrabold tracking-tight mb-6 leading-[1.1]"
                    >
                        ¿Buscas ser parte de nosotros? <br />
                        <span class="text-umb-verde">Ponte en contacto</span>
                    </h1>
                    <p class="text-gray-600 text-lg mb-10 font-medium">
                        En la Universidad Mexiquense del Bicentenario estamos en
                        constante búsqueda de talento. Si deseas formar parte de
                        nuestra plantilla docente o administrativa, envíanos tus
                        datos.
                    </p>

                    <div
                        class="bg-white p-8 rounded-[1.5rem] shadow-xl shadow-gray-200/50 border border-gray-100 flex flex-col gap-4"
                    >
                        <h3 class="text-2xl font-bold text-gray-900 font-serif">
                            Postúlate a una vacante
                        </h3>
                        <p class="text-gray-500 mb-4 text-sm">
                            Llena este formulario y Recursos Humanos se pondrá
                            en contacto contigo.
                        </p>

                        <form
                            name="bolsa-trabajo"
                            method="POST"
                            data-netlify="true"
                            netlify-honeypot="bot-field"
                            class="flex flex-col gap-4"
                        >
                            <p class="hidden">
                                <label
                                    >No llenes esto: <input
                                        name="bot-field"
                                    /></label>
                            </p>
                            <input
                                type="hidden"
                                name="form-name"
                                value="bolsa-trabajo"
                            />

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-700 mb-1"
                                    >Nombre Completo</label
                                >
                                <input
                                    type="text"
                                    name="nombre"
                                    required
                                    class="w-full rounded-md border-gray-300 shadow-sm focus:border-umb-verde focus:ring-umb-verde p-2.5 border"
                                    placeholder="Ej. Juan Pérez"
                                />
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-700 mb-1"
                                    >Correo Electrónico</label
                                >
                                <input
                                    type="email"
                                    name="email"
                                    required
                                    class="w-full rounded-md border-gray-300 shadow-sm focus:border-umb-verde focus:ring-umb-verde p-2.5 border"
                                    placeholder="correo@ejemplo.com"
                                />
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-sm font-semibold text-gray-700 mb-1"
                                        >Teléfono</label
                                    >
                                    <input
                                        type="tel"
                                        name="telefono"
                                        required
                                        class="w-full rounded-md border-gray-300 shadow-sm focus:border-umb-verde focus:ring-umb-verde p-2.5 border"
                                        placeholder="55 1234 5678"
                                    />
                                </div>
                                <div>
                                    <label
                                        class="block text-sm font-semibold text-gray-700 mb-1"
                                        >Vacante</label
                                    >
                                    <input
                                        type="text"
                                        name="vacante"
                                        required
                                        class="w-full rounded-md border-gray-300 shadow-sm focus:border-umb-verde focus:ring-umb-verde p-2.5 border"
                                        placeholder="Ej. Docente TICs"
                                    />
                                </div>
                            </div>

                            <button
                                type="submit"
                                class="w-full mt-2 bg-umb-verde text-center text-white font-extrabold text-lg py-3 rounded-xl hover:bg-emerald-700 transition-all duration-300 shadow-md hover:-translate-y-1"
                            >
                                Enviar Postulación ✉️
                            </button>
                        </form>
                    </div>
                </div>

                <div
                    class="lg:col-span-7 h-[450px] md:h-[600px] relative rounded-[2.5rem] overflow-hidden shadow-2xl group"
                >
                    <img
                        src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
                        alt="Comunidad UMB"
                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />

                    <div
                        class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/40 to-transparent"
                    >
                    </div>

                    <div class="absolute bottom-0 left-0 w-full p-8 md:p-12">
                        <h2
                            class="text-3xl md:text-5xl font-serif font-black text-white leading-tight uppercase drop-shadow-lg"
                        >
                            Forma parte del <br /><span class="text-emerald-400"
                                >orgullo UMB</span
                            >
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

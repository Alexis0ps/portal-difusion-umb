---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main
        class="min-h-screen bg-slate-50 pt-28 pb-24 font-sans relative overflow-hidden"
    >
        <div
            class="absolute top-0 left-0 w-full h-[600px] bg-gradient-to-b from-green-50 to-slate-50 z-0 pointer-events-none"
        >
        </div>

        <div class="max-w-[1400px] mx-auto px-6 relative z-10">
            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16 pt-8"
            >
                <div class="lg:col-span-5 flex flex-col justify-center">
                    <h1
                        class="text-5xl md:text-6xl font-serif text-gray-900 font-extrabold tracking-tight mb-6 leading-[1.1]"
                    >
                        ¿Buscas ser parte de nosotros? <br />
                        <span class="text-umb-verde">Ponte en contacto</span>
                    </h1>
                    <p class="text-gray-600 text-lg mb-10 font-medium">
                        En la Universidad Mexiquense del Bicentenario estamos en
                        constante búsqueda de talento. Si deseas formar parte de
                        nuestra plantilla docente o del área administrativa,
                        envíanos tu información.
                    </p>

                    <div
                        class="bg-white p-8 rounded-[1.5rem] shadow-xl shadow-gray-200/50 border border-gray-100 flex flex-col gap-4"
                    >
                        <h3 class="text-2xl font-bold text-gray-900 font-serif">
                            Envía tu Currículum
                        </h3>
                        <p class="text-gray-500 mb-2">
                            Nuestro departamento de Recursos Humanos revisará tu
                            perfil para considerarte en futuras oportunidades
                            laborales.
                        </p>
                        <a
                            href="mailto:recursos.humanos@umb.edu.mx"
                            class="w-full bg-umb-verde text-center text-white font-extrabold text-lg py-4 rounded-xl hover:bg-emerald-700 transition-all duration-300 shadow-md hover:-translate-y-1 inline-block"
                        >
                            Enviar CV por correo ✉️
                        </a>
                    </div>
                </div>

                <div
                    class="lg:col-span-7 h-[450px] md:h-[600px] relative rounded-[2.5rem] overflow-hidden shadow-2xl group"
                >
                    <img
                        src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
                        alt="Comunidad UMB"
                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />

                    <div
                        class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/40 to-transparent"
                    >
                    </div>

                    <div class="absolute bottom-0 left-0 w-full p-8 md:p-12">
                        <h2
                            class="text-3xl md:text-5xl font-serif font-black text-white leading-tight uppercase drop-shadow-lg"
                        >
                            Forma parte del <br /><span class="text-emerald-400"
                                >orgullo UMB</span
                            >
                        </h2>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <a
                    href="mailto:recursos.humanos@umb.edu.mx?subject=Postulación%20Área%20Docente"
                    class="relative h-32 rounded-[2rem] overflow-hidden group cursor-pointer shadow-md hover:shadow-xl transition-all duration-300 block hover:-translate-y-1"
                >
                    <div class="absolute inset-0 bg-gray-900"></div>
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-umb-verde/80 to-transparent z-10"
                    >
                    </div>
                    <div
                        class="absolute inset-0 p-8 flex items-center justify-between z-20"
                    >
                        <span
                            class="text-white font-extrabold text-2xl font-serif drop-shadow-md"
                            >Área Docente e <br />Investigación</span
                        >
                        <span
                            class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white backdrop-blur-sm group-hover:bg-white group-hover:text-umb-verde transition-colors shadow-sm"
                            >&rarr;</span
                        >
                    </div>
                </a>

                <a
                    href="mailto:recursos.humanos@umb.edu.mx?subject=Postulación%20Área%20Administrativa"
                    class="relative h-32 rounded-[2rem] overflow-hidden group cursor-pointer shadow-md hover:shadow-xl transition-all duration-300 block hover:-translate-y-1"
                >
                    <div class="absolute inset-0 bg-gray-800"></div>
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-emerald-600/80 to-transparent z-10"
                    >
                    </div>
                    <div
                        class="absolute inset-0 p-8 flex items-center justify-between z-20"
                    >
                        <span
                            class="text-white font-extrabold text-2xl font-serif drop-shadow-md"
                            >Área Administrativa <br />y Operativa</span
                        >
                        <span
                            class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white backdrop-blur-sm group-hover:bg-white group-hover:text-umb-verde transition-colors shadow-sm"
                            >&rarr;</span
                        >
                    </div>
                </a>
            </div>
        </div>
    </main>
</Layout>
